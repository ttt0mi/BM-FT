generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum TransactionType {
    INCOME
    EXPENSE
    TRANSFER
}

enum BudgetPeriod {
    WEEKLY
    MONTHLY
    YEARLY
}

model User {
    id             String    @id @default(cuid())
    email          String    @unique
    firstName      String
    lastName       String
    hashedPassword String
    createdAt      DateTime  @default(now())
    updatedAt      DateTime  @updatedAt
    deletedAt      DateTime?

    accounts Account[]
    budgets  Budget[]

    @@map("users")
}

model Account {
    id                 String    @id @default(cuid())
    userId             String
    type               String // e.g. "Current", "Savings"
    balanceInMinorUnit BigInt    @default(0)
    currency           String    @default("NGN")
    createdAt          DateTime  @default(now())
    updatedAt          DateTime  @updatedAt
    deletedAt          DateTime?

    user                 User          @relation(fields: [userId], references: [id])
    outgoingTransactions Transaction[] @relation("FromAccount")
    incomingTransactions Transaction[] @relation("ToAccount")

    @@index([userId])
    @@map("accounts")
}

model Category {
    id        String   @id @default(cuid())
    name      String   @unique // e.g. "Food", "Rent", "Salary"
    icon      String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    transactions Transaction[]
    budgets      Budget[]

    @@map("categories")
}

model Transaction {
    id                String          @id @default(cuid())
    fromAccountId     String?
    toAccountId       String?
    categoryId        String
    type              TransactionType
    amountInMinorUnit BigInt
    description       String
    date              DateTime
    idempotencyKey    String?         @unique
    createdAt         DateTime        @default(now())
    updatedAt         DateTime        @updatedAt
    // To "edit" a transaction, reverse it and create a new one.
    reversedById      String?         @unique
    reversedBy        Transaction?    @relation("Reversal", fields: [reversedById], references: [id])
    reversalOf        Transaction?    @relation("Reversal")

    fromAccount Account? @relation("FromAccount", fields: [fromAccountId], references: [id])
    toAccount   Account? @relation("ToAccount", fields: [toAccountId], references: [id])
    category    Category @relation(fields: [categoryId], references: [id])

    @@index([fromAccountId])
    @@index([toAccountId])
    @@index([categoryId])
    @@index([date])
    @@map("transactions")
}

model Budget {
    id               String       @id @default(cuid())
    userId           String
    categoryId       String
    limitInMinorUnit BigInt
    period           BudgetPeriod
    startDate        DateTime
    endDate          DateTime?
    createdAt        DateTime     @default(now())
    updatedAt        DateTime     @updatedAt

    user     User     @relation(fields: [userId], references: [id])
    category Category @relation(fields: [categoryId], references: [id])

    @@index([userId])
    @@index([categoryId])
    @@map("budgets")
}
