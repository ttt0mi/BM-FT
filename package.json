{
    "name": "bm-ft",
    "version": "1.0.0",
    "description": "Industry-standard budgeting backend API",
    "main": "./dist/server.js",
    "scripts": {
        "dev": "cross-env NODE_ENV=development tsx watch src/server.ts",
        "build": "tsc",
        "watch": "tsc --watch",
        "start": "cross-env NODE_ENV=production node dist/server.js",
        "db:migrate": "dotenv -e .env.development -- prisma migrate dev",
        "db:deploy": "dotenv -e .env.production -- prisma migrate deploy",
        "db:studio": "prisma studio",
        "postinstall": "prisma generate",
        "db:seed": "tsx prisma/seed.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "format": "prettier --write src/**/*.ts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ttt0mi/BM-FT.git"
    },
    "keywords": [],
    "author": "Tomi Omolokun",
    "license": "ISC",
    "type": "module",
    "bugs": {
        "url": "https://github.com/ttt0mi/BM-FT/issues"
    },
    "homepage": "https://github.com/ttt0mi/BM-FT#readme",
    "devDependencies": {
        "@types/node": "^26.0.1",
        "@types/pg": "^8.20.0",
        "@types/supertest": "^7.2.0",
        "@typescript-eslint/eslint-plugin": "^8.62.0",
        "@typescript-eslint/parser": "^8.62.0",
        "@vitest/coverage-v8": "^4.1.9",
        "cross-env": "^10.1.0",
        "dotenv-cli": "^11.0.0",
        "eslint": "^10.5.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "nodemon": "^3.1.14",
        "pino-pretty": "^13.1.3",
        "prettier": "^3.8.4",
        "prisma": "^7.8.0",
        "supertest": "^7.2.2",
        "ts-node": "^10.9.2",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3",
        "vitest": "^4.1.9"
    },
    "dependencies": {
        "@fastify/cors": "^11.2.0",
        "@fastify/env": "^7.0.0",
        "@fastify/helmet": "^13.0.2",
        "@fastify/jwt": "^10.1.0",
        "@fastify/sensible": "^6.0.4",
        "@fastify/type-provider-zod": "^1.0.0",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "decimal.js": "^10.6.0",
        "dotenv": "^17.4.2",
        "fastify": "^5.8.5",
        "fastify-plugin": "^6.0.0",
        "pg": "^8.22.0",
        "zod": "^4.4.3"
    }
}